{
	email {$LETSENCRYPT_EMAIL}
	# Third-party directive (caddy/Dockerfile), so Caddy needs to be told where
	# it runs relative to the others.
	order rate_limit before basicauth
}

# Per-client request ceiling, a safety net against a flood (misbehaving sync
# client, scraper, bot) piling up in the backends — on 2026-11-11 that exhausted
# the VM's memory. Deliberately generous: it must never trip for normal use,
# only for something far outside it. Requests over the limit get 429 with a
# Retry-After header, which well-behaved clients (including Nextcloud's) honour.
#
# Only public clients are counted. Collabora's WOPI callbacks and Nextcloud's
# discovery fetch reach Caddy from inside the Docker network (see the aliases in
# docker-compose.nextcloud.yml), i.e. all from one address; counting them would
# throttle every editor session at once.
#
# Usage: import ratelimit <zone name> <events per minute>
(ratelimit) {
	@public_{args[0]} not remote_ip private_ranges
	rate_limit @public_{args[0]} {
		zone {args[0]} {
			key {remote_host}
			events {args[1]}
			window 1m
		}
	}
}

{$DOMAIN_AUTH} {
	import ratelimit auth 300
	reverse_proxy keycloak:8080
}

# DOMAIN_WIKI is a public test hostname (wiki.scout-tools.de) until Cutover A,
# so Let's Encrypt can validate it like DOMAIN_AUTH — no internal certificate
# or /etc/hosts entry needed. Switching to wiki.dpvonline.de later is the same
# as for DOMAIN_AUTH: change the Key Vault secret, restart dpv-compose.service.
{$DOMAIN_WIKI} {
	import ratelimit wiki 600
	reverse_proxy confluence:8090
}

# Nextcloud and Collabora — cloud./office.scout-tools.de for the test copy until
# Cutover B, then the dpvonline.de names (same switch as above). Until
# docker-compose.nextcloud.yml is part of the stack these answer 502, which is
# harmless.
{$DOMAIN_CLOUD} {
	# Sync clients are chatty (one PROPFIND per folder), hence the higher value.
	import ratelimit cloud 1200
	# CalDAV/CardDAV discovery for calendar and contacts clients. Handled here
	# because Nextcloud's own .htaccess rule would redirect to http:// behind a
	# TLS-terminating proxy.
	redir /.well-known/carddav /remote.php/dav/ 301
	redir /.well-known/caldav /remote.php/dav/ 301
	header Strict-Transport-Security "max-age=15552000; includeSubDomains"
	reverse_proxy nextcloud:80
}

# WebSockets (the editor session) pass through reverse_proxy without extra config.
{$DOMAIN_OFFICE} {
	reverse_proxy collabora:9980
}
