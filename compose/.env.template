# Reference only — the real .env (gitignored) is generated on the VM at boot
# by scripts/fetch-secrets.sh, which pulls the *_PASSWORD values from Key
# Vault via the VM's managed identity. Nothing here is ever filled in by hand.

# COMPOSE_FILE gains :docker-compose.nextcloud.yml once a Nextcloud
# installation exists, COMPOSE_PROFILES=nextcloud-live once DOMAIN_CLOUD is
# cloud.dpvonline.de — both decided by fetch-secrets.sh.
COMPOSE_FILE=docker-compose.yml:docker-compose.postgres.yml:docker-compose.keycloak.yml:docker-compose.confluence.yml
COMPOSE_PROFILES=
DOMAIN_AUTH=
DOMAIN_WIKI=
DOMAIN_CLOUD=
DOMAIN_OFFICE=
LETSENCRYPT_EMAIL=
POSTGRES_SUPERUSER_PASSWORD=
POSTGRES_KEYCLOAK_PASSWORD=
KEYCLOAK_ADMIN_PASSWORD=
POSTGRES_NEXTCLOUD_PASSWORD=
COLLABORA_ADMIN_PASSWORD=
