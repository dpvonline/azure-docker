[Unit]
Description=Delete never-verified Keycloak registrations (older than 48h)
After=docker.service dpv-compose.service
Requires=docker.service

[Service]
Type=oneshot
# First run clears the ~1000 bot backlog; later runs are far below the cap.
Environment=MAX_DELETIONS=3000
ExecStart=/opt/dpv/scripts/keycloak-prune-unverified.sh --delete
TimeoutStartSec=1800
